fn main() -> i32 {
	let list = list_new::<i32>();
	for i in 1..6 {
		list_print(&list);
		list_insert::<i32>(&list, i);
	}
	list_print(&list);
	0
}

struct List<T> {
	head: *Node<T>,
}

struct Node<T> {
	value: T,
	next: *Node<T>,
}

fn list_new<T>() -> List<T> {
	.{ head: null }
}

fn list_print(list: *List<i32>) {
	let ptr = list.head;
	printf("[");
	while ptr != null {
		if ptr != list.head { printf(", "); }
		printf("%i", ptr.value);
		ptr = ptr.next;
	}
	printf("]\n");
}

fn list_insert<T>(list: *List<T>, value: T) {
	let new_head = alloc::<Node<T>>();
	new_head.* = .{ value: value, next: list.head };
	list.head = new_head;
}

fn alloc<T>() -> *T {
	malloc(size_of::<T>()) as *T
}

@intrinsic @pure fn size_of<T>() -> usize;
fn malloc(size: usize) -> ptr;
fn printf(fmt: *i8, ...);
